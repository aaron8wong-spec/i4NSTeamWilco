root ::= cmd-goto | cmd-search-area | cmd-loiter | cmd-hold | cmd-return-home | cmd-report-status | cmd-clarify
place ::= "\"" [a-z] [a-z0-9_]{1,31} "\""
altm ::= ([1-9] | ("1" [0-9] | [2-8] [0-9]{1} | "9" [0-9]) | ("1" ("0" [0-9] | [1-8] [0-9]{1} | "9" [0-9]) | [2-8] [0-9]{2} | "9" ("0" [0-9] | [1-8] [0-9]{1} | "9" [0-9])) | ("1" ("0" ("0" [0-0]))))
lat ::= num
lon ::= num
cmd-goto ::= "{" ws "\"action\"" ws ":" ws "\"goto\"" ws "," ws "\"params\"" ws ":" ws ("{" ws "\"place\"" ws ":" ws place ws "," ws "\"alt_m\"" ws ":" ws altm ws "}" | "{" ws "\"lat\"" ws ":" ws lat ws "," ws "\"lon\"" ws ":" ws lon ws "," ws "\"alt_m\"" ws ":" ws altm ws "}") ws "}"
radiusm ::= ([5-9] | ("1" [0-9] | [2-8] [0-9]{1} | "9" [0-9]) | ("1" ("0" [0-9] | [1-8] [0-9]{1} | "9" [0-9]) | [2-8] [0-9]{2} | "9" ("0" [0-9] | [1-8] [0-9]{1} | "9" [0-9])) | ("1" ("0" ("0" [0-9] | [1-8] [0-9]{1} | "9" [0-9]) | [1-8] [0-9]{2} | "9" ("0" [0-9] | [1-8] [0-9]{1} | "9" [0-9])) | [2-4] [0-9]{3} | "5" ("0" ("0" [0-0]))))
targettype ::= ("\"vehicle\"" | "\"person\"" | "\"structure\"" | "\"any\"")
cmd-search-area ::= "{" ws "\"action\"" ws ":" ws "\"search_area\"" ws "," ws "\"params\"" ws ":" ws ("{" ws "\"place\"" ws ":" ws place ws "," ws "\"radius_m\"" ws ":" ws radiusm ws "," ws "\"alt_m\"" ws ":" ws altm ws "," ws "\"target\"" ws ":" ws targettype ws "}" | "{" ws "\"lat\"" ws ":" ws lat ws "," ws "\"lon\"" ws ":" ws lon ws "," ws "\"radius_m\"" ws ":" ws radiusm ws "," ws "\"alt_m\"" ws ":" ws altm ws "," ws "\"target\"" ws ":" ws targettype ws "}") ws "}"
eventid ::= "\"" "E" [0-9]{2,4} "\""
durations ::= ([1-9] | ("1" [0-9] | [2-8] [0-9]{1} | "9" [0-9]) | ("1" ("0" [0-9] | [1-8] [0-9]{1} | "9" [0-9]) | [2-8] [0-9]{2} | "9" ("0" [0-9] | [1-8] [0-9]{1} | "9" [0-9])) | ("1" ("0" ("0" [0-9] | [1-8] [0-9]{1} | "9" [0-9]) | [1-8] [0-9]{2} | "9" ("0" [0-9] | [1-8] [0-9]{1} | "9" [0-9])) | [2-2] [0-9]{3} | "3" ("0" ("0" [0-9] | [1-8] [0-9]{1} | "9" [0-9]) | [1-5] [0-9]{2} | "6" ("0" [0-0]))))
cmd-loiter ::= "{" ws "\"action\"" ws ":" ws "\"loiter\"" ws "," ws "\"params\"" ws ":" ws ("{" ws "\"event_id\"" ws ":" ws eventid ws "," ws "\"radius_m\"" ws ":" ws radiusm ws "," ws "\"duration_s\"" ws ":" ws durations ws "}" | "{" ws "\"place\"" ws ":" ws place ws "," ws "\"radius_m\"" ws ":" ws radiusm ws "," ws "\"duration_s\"" ws ":" ws durations ws "}" | "{" ws "\"lat\"" ws ":" ws lat ws "," ws "\"lon\"" ws ":" ws lon ws "," ws "\"radius_m\"" ws ":" ws radiusm ws "," ws "\"duration_s\"" ws ":" ws durations ws "}") ws "}"
cmd-hold ::= "{" ws "\"action\"" ws ":" ws "\"hold\"" ws "," ws "\"params\"" ws ":" ws "{" ws "}" ws "}"
cmd-return-home ::= "{" ws "\"action\"" ws ":" ws "\"return_home\"" ws "," ws "\"params\"" ws ":" ws "{" ws "}" ws "}"
cmd-report-status ::= "{" ws "\"action\"" ws ":" ws "\"report_status\"" ws "," ws "\"params\"" ws ":" ws "{" ws "}" ws "}"
cmd-clarify ::= "{" ws "\"action\"" ws ":" ws "\"clarify\"" ws "," ws "\"params\"" ws ":" ws "{" ws "\"reason\"" ws ":" ws ("\"missing_location\"" | "\"missing_altitude\"" | "\"ambiguous_reference\"" | "\"unsupported_action\"" | "\"unsafe_request\"" | "\"unclear_speech\"") ws "," ws "\"question\"" ws ":" ws "\"" strchar{1,160} "\"" ws "}" ws "}"
ws ::= [ \t\n]{0,2}
num ::= "-"? [0-9]+ ("." [0-9]+)?
strchar ::= [^"\\\x00-\x1f] | "\\" ["\\/bfnrt]
